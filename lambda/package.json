{
  "name": "postman-test-lambda",
  "version": "7.0.0",
  "description": "Lambda function that runs postman collection tests",
  "repository": {
    "type": "git",
    "url": "https://github.com/byu-oit/terraform-aws-postman-test-lambda"
  },
  "main": "src/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test",
    "lint": "standard",
    "package": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && ncc build src/index.js -m -o dist && cd dist && zip -r function.zip . -x function.zip"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-codedeploy": "^3.1148.0",
    "@aws-sdk/client-s3": "^3.1148.0",
    "newman": "^6.2.3"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.45.0",
    "standard": "^17.1.2"
  },
  "overrides": {
    "flatted": "^3.4.4",
    "handlebars": "^4.7.10",
    "jose": "^4.15.9",
    "lodash": "^4.18.1",
    "node-forge": "^1.4.0",
    "postman-request": "2.88.1-postman.49",
    "qs": "^6.16.0",
    "underscore": "^1.13.8"
  },
  "standard": {
    "ignore": [
      "dist/**"
    ]
  }
}
